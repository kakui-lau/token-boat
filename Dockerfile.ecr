ARG APP_VERSION=dev

FROM public.ecr.aws/docker/library/node:22-alpine@sha256:c610fcdfb1d5b4740dd70c284ed3cb16bb857e0f7166196e36a5501df7a3aa32 AS bun-base

RUN npm install --global --no-audit --no-fund bun@1.3.14 \
    && test "$(bun --version)" = "1.3.14"

FROM bun-base AS legacy-frontend-builder

ARG APP_VERSION

WORKDIR /build/web
COPY web/package.json web/bun.lock ./
RUN bun install --frozen-lockfile
COPY ./web ./
RUN DISABLE_ESLINT_PLUGIN='true' VITE_REACT_APP_VERSION="${APP_VERSION}" bun run build

FROM bun-base AS console-frontend-builder

WORKDIR /build/frontend
COPY frontend/package.json frontend/bun.lock frontend/tsconfig.base.json frontend/.oxfmtrc.json ./
COPY frontend/apps/admin/package.json ./apps/admin/package.json
COPY frontend/apps/console/package.json ./apps/console/package.json
COPY frontend/apps/site/package.json ./apps/site/package.json
COPY frontend/packages/api-client/package.json ./packages/api-client/package.json
COPY frontend/packages/app-core/package.json ./packages/app-core/package.json
COPY frontend/packages/tokens/package.json ./packages/tokens/package.json
COPY frontend/packages/ui/package.json ./packages/ui/package.json
RUN bun install --frozen-lockfile
COPY ./frontend ./
RUN bun run build

FROM public.ecr.aws/docker/library/golang:1.26.1-alpine@sha256:2389ebfa5b7f43eeafbd6be0c3700cc46690ef842ad962f6c5bd6be49ed82039 AS builder2
ARG APP_VERSION
ENV GO111MODULE=on CGO_ENABLED=0 GOPROXY=https://goproxy.cn,direct

ARG TARGETOS
ARG TARGETARCH
ENV GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH:-amd64}
ENV GOEXPERIMENT=greenteagc

WORKDIR /build

ADD go.mod go.sum ./
COPY relaykit/go.mod relaykit/go.sum ./relaykit/
RUN go mod download

COPY . .
COPY --from=legacy-frontend-builder /build/web/dist ./web/dist
RUN mkdir -p ./web/dist/legacy && cp ./web/dist/index.html ./web/dist/legacy/index.html
COPY --from=console-frontend-builder /build/frontend/apps/site/dist ./web/dist
COPY --from=console-frontend-builder /build/frontend/apps/console/dist ./web/dist/console
RUN ./scripts/check-web-assembly.sh ./web/dist
RUN go build -ldflags "-s -w -X 'github.com/QuantumNous/new-api/common.Version=${APP_VERSION}'" -o new-api \
    && go build -ldflags "-s -w" -o pricing-readiness ./cmd/local-pricing-bootstrap \
    && go build -ldflags "-s -w" -o db-migrate ./cmd/db-migrate \
    && mkdir -p /runtime-root/data /runtime-root/tmp

FROM public.ecr.aws/docker/library/alpine:3.23@sha256:fd791d74b68913cbb027c6546007b3f0d3bc45125f797758156952bc2d6daf40

RUN apk add --no-cache tzdata

COPY --from=builder2 --chown=65532:65532 /runtime-root/data /data
COPY --from=builder2 --chown=65532:65532 /runtime-root/tmp /tmp
COPY --from=builder2 --chown=65532:65532 /build/new-api /
COPY --from=builder2 --chown=65532:65532 /build/pricing-readiness /
COPY --from=builder2 --chown=65532:65532 /build/db-migrate /
COPY --chown=65532:65532 LICENSE NOTICE THIRD-PARTY-LICENSES.md /licenses/
EXPOSE 3000
WORKDIR /data
ENV HOME=/data TMPDIR=/tmp
USER 65532:65532
ENTRYPOINT ["/new-api"]
