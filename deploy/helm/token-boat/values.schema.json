{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "image",
    "existingSecret",
    "worker",
    "master",
    "serviceAccount",
    "service",
    "autoscaling",
    "podDisruptionBudget",
    "nodePool",
    "ingress"
  ],
  "properties": {
    "image": {
      "type": "object",
      "required": ["repository", "digest", "pullPolicy"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "pullPolicy": {"enum": ["Always", "IfNotPresent", "Never"]}
      }
    },
    "existingSecret": {"type": "string", "minLength": 1},
    "worker": {
      "type": "object",
      "required": ["replicaCount", "publicSiteMode", "resources"],
      "properties": {
        "replicaCount": {"type": "integer", "minimum": 1},
        "publicSiteMode": {"enum": ["new", "legacy"]}
      }
    },
    "master": {
      "type": "object",
      "required": ["enabled", "replicaCount", "resources"],
      "properties": {
        "enabled": {"type": "boolean"},
        "replicaCount": {"type": "integer", "minimum": 1, "maximum": 1}
      }
    },
    "serviceAccount": {
      "type": "object",
      "required": ["create", "name", "automount"],
      "properties": {
        "create": {"type": "boolean"},
        "name": {"type": "string", "minLength": 1},
        "automount": {"type": "boolean"}
      }
    },
    "service": {
      "type": "object",
      "required": ["type", "port", "targetPort"],
      "properties": {
        "type": {"enum": ["ClusterIP"]},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "targetPort": {"type": "integer", "minimum": 1, "maximum": 65535}
      }
    },
    "autoscaling": {
      "type": "object",
      "required": ["enabled", "minReplicas", "maxReplicas"],
      "properties": {
        "enabled": {"type": "boolean"},
        "minReplicas": {"type": "integer", "minimum": 1},
        "maxReplicas": {"type": "integer", "minimum": 1}
      }
    },
    "podDisruptionBudget": {
      "type": "object",
      "required": ["enabled", "minAvailable"],
      "properties": {
        "enabled": {"type": "boolean"},
        "minAvailable": {"type": "integer", "minimum": 1}
      }
    },
    "nodePool": {
      "type": "object",
      "required": ["create", "name", "architecture", "capacityTypes", "taint"],
      "properties": {
        "create": {"type": "boolean"},
        "name": {"type": "string", "minLength": 1},
        "architecture": {"enum": ["arm64"]},
        "capacityTypes": {
          "type": "array",
          "minItems": 1,
          "items": {"enum": ["on-demand", "spot"]}
        }
      }
    },
    "ingress": {
      "type": "object",
      "required": ["enabled", "name", "class", "hosts", "externalDNS"],
      "properties": {
        "enabled": {"type": "boolean"},
        "name": {"type": "string", "minLength": 1},
        "hosts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(\\*\\.)?([a-zA-Z0-9-]+\\.)+[a-zA-Z]{2,}$"
          }
        },
        "externalDNS": {
          "type": "object",
          "required": ["enabled", "hostnames"],
          "properties": {
            "enabled": {"type": "boolean"},
            "hostnames": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    }
  }
}
