# The default `bun run dev` command uses the existing local API on port 3000.
VITE_CONSOLE_DATA_MODE=live

# Set only for an isolated integration backend. Leave empty for same-origin API calls.
VITE_CONSOLE_API_BASE_URL=

# Used by the Vite dev server in Live mode. Browser requests remain same-origin.
VITE_CONSOLE_API_PROXY_TARGET=http://127.0.0.1:3000

# Used only by the shared-origin new + legacy frontend gateway.
VITE_CONSOLE_LEGACY_PROXY_TARGET=http://127.0.0.1:5174
