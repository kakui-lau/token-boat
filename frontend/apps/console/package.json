{
  "name": "@token-boat/console",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "VITE_CONSOLE_DATA_MODE=live VITE_CONSOLE_API_PROXY_TARGET=http://127.0.0.1:3000 vite --host 127.0.0.1 --port 5173 --mode live",
    "dev:live": "VITE_CONSOLE_DATA_MODE=live VITE_CONSOLE_API_PROXY_TARGET=http://127.0.0.1:3000 vite --host 127.0.0.1 --port 5173 --mode live",
    "dev:gateway": "VITE_CONSOLE_DATA_MODE=live VITE_CONSOLE_API_PROXY_TARGET=http://127.0.0.1:3000 VITE_CONSOLE_LEGACY_PROXY_TARGET=http://127.0.0.1:5174 vite --host 127.0.0.1 --port 5173 --strictPort --mode live",
    "dev:demo": "VITE_CONSOLE_DATA_MODE=demo vite --host 127.0.0.1 --port 5173",
    "build": "vite build && bun run bundle:check && tsc -b",
    "bundle:check": "bun ./scripts/check-bundle-budget.mjs",
    "typecheck": "tsc -b",
    "test": "vitest run"
  },
  "dependencies": {
    "@copilotkit/react-core": "^1.69.3",
    "@hookform/resolvers": "^5.9.1",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-router": "^1.170.32",
    "@token-boat/api-client": "workspace:*",
    "@token-boat/app-core": "workspace:*",
    "@token-boat/tokens": "workspace:*",
    "@token-boat/ui": "workspace:*",
    "i18next": "^26.4.0",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^1.34.0",
    "next-themes": "^0.4.6",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.86.0",
    "react-i18next": "^17.0.12",
    "recharts": "3.8.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "viem": "^2.56.1",
    "wagmi": "^3.7.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-plugin": "^1.168.35",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "happy-dom": "^20.11.12",
    "msw": "^2.15.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
