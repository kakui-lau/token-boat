---
import { localizedPath, type SiteLocale } from "@/content/site-copy";
import { legalDocumentDrafts } from "@/content/legal-documents";
import { LegalDocument } from "@/islands/legal/legal-document";
import { StatusPanel } from "@/islands/status/status-panel";
import EditorialPageHero from "@/components/editorial-page-hero.astro";
import { marked } from "marked";

type ContentPageKey = "about" | "docs" | "privacy" | "status" | "terms";

type Props = {
  locale: SiteLocale;
  page: ContentPageKey;
};

type ContentCard = {
  action?: string;
  description: string;
  href?: string;
  index: string;
  label: string;
  title: string;
};

type ContentPage = {
  cards: ContentCard[];
  cta?: { action: string; href: string; label: string; title: string };
  eyebrow: string;
  lead: string;
  titleLines: string[];
};

const props = Astro.props;
const pages: Record<SiteLocale, Record<ContentPageKey, ContentPage>> = {
  zh: {
    docs: {
      eyebrow: "开发者文档",
      titleLines: ["从 API Key，", "到第一条", "响应。"],
      lead: "从最短接入路径开始；需要深入时，再进入模型目录、价格、用量和请求日志。",
      cards: [
        {
          action: "打开快速开始",
          description: "创建 API Key、选择当前可用模型，并用熟悉的 OpenAI SDK 发起第一条请求。",
          href: "/console/getting-started",
          index: "01",
          label: "QUICKSTART",
          title: "完成首次接入",
        },
        {
          action: "浏览模型",
          description: "按供应商和能力类型筛选模型，同时查看上下文与公开价格摘要。",
          href: localizedPath("zh", "/models"),
          index: "02",
          label: "MODEL SELECTION",
          title: "选择适合任务的模型",
        },
        {
          action: "比较价格",
          description: "在写入生产代码前比较输入、输出和媒体计费单位，登录后确认账户价格。",
          href: `${localizedPath("zh", "/models")}#catalog`,
          index: "03",
          label: "PRICING",
          title: "理解调用成本",
        },
      ],
      cta: {
        action: "开始接入",
        href: "/console/getting-started",
        label: "READY TO BUILD",
        title: "准备好发送第一条请求了吗？",
      },
    },
    status: {
      eyebrow: "服务状态",
      titleLines: ["查看当前", "公开服务", "状态。"],
      lead: "这里只展示已接入公开监控的数据。账户级请求问题可登录控制台，通过请求日志继续定位。",
      cards: [],
    },
    about: {
      eyebrow: "关于 Token Boat",
      titleLines: ["为持续使用", "AI 模型的", "团队而建。"],
      lead: "Token Boat 服务于需要同时评估、接入和运营多种 AI 模型的产品、开发与运营团队。",
      cards: [
        {
          description: "用兼容接口和熟悉的 SDK 接入模型，把更多时间留给产品逻辑与用户体验。",
          index: "01",
          label: "FOR DEVELOPERS",
          title: "更短的接入路径",
        },
        {
          description: "在模型能力、响应质量和公开价格之间做选择，而不把产品锁定在单一供应商。",
          index: "02",
          label: "FOR PRODUCT TEAMS",
          title: "更灵活的模型选择",
        },
        {
          description: "通过用量、请求和账户价格理解成本，让日常运营与问题定位更清楚。",
          index: "03",
          label: "FOR OPERATIONS",
          title: "更清晰的运行视图",
        },
      ],
      cta: {
        action: "浏览模型",
        href: localizedPath("zh", "/models"),
        label: "EXPLORE THE CATALOG",
        title: "看看现在可用的模型。",
      },
    },
    terms: {
      eyebrow: "法律",
      titleLines: ["阅读当前", "服务", "条款。"],
      lead: "阅读适用于 Token Boat 账户、服务使用和费用相关事项的当前条款。",
      cards: [],
    },
    privacy: {
      eyebrow: "法律",
      titleLines: ["了解当前", "隐私", "政策。"],
      lead: "了解 Token Boat 如何处理与账户、服务访问和用户提交内容相关的信息。",
      cards: [],
    },
  },
  en: {
    docs: {
      eyebrow: "Developer documentation",
      titleLines: ["FROM API KEY", "TO FIRST", "RESPONSE."],
      lead: "Begin with the shortest integration path, then move into models, pricing, usage, and request logs when you need more detail.",
      cards: [
        {
          action: "Open quickstart",
          description: "Create an API key, choose a current model, and send the first request with a familiar OpenAI SDK.",
          href: "/console/getting-started",
          index: "01",
          label: "QUICKSTART",
          title: "Complete the first integration",
        },
        {
          action: "Browse models",
          description: "Filter models by provider and capability while reviewing context and public price summaries.",
          href: localizedPath("en", "/models"),
          index: "02",
          label: "MODEL SELECTION",
          title: "Choose a model for the task",
        },
        {
          action: "Compare pricing",
          description: "Compare input, output, and media billing units before production, then sign in to confirm account pricing.",
          href: `${localizedPath("en", "/models")}#catalog`,
          index: "03",
          label: "PRICING",
          title: "Understand call costs",
        },
      ],
      cta: {
        action: "Start building",
        href: "/console/getting-started",
        label: "READY TO BUILD",
        title: "Ready to send the first request?",
      },
    },
    status: {
      eyebrow: "Service status",
      titleLines: ["SEE THE PUBLIC", "SERVICE", "STATUS."],
      lead: "This page shows only data connected to public monitoring. For account-level request issues, sign in and continue with Request Logs.",
      cards: [],
    },
    about: {
      eyebrow: "About Token Boat",
      titleLines: ["BUILT FOR TEAMS", "WORKING WITH", "AI MODELS."],
      lead: "Token Boat serves product, engineering, and operations teams that need to evaluate, integrate, and run multiple AI models.",
      cards: [
        {
          description: "Use compatible endpoints and familiar SDKs, keeping more engineering time for product logic and user experience.",
          index: "01",
          label: "FOR DEVELOPERS",
          title: "A shorter integration path",
        },
        {
          description: "Choose across capability, response quality, and public pricing without locking the product to one provider.",
          index: "02",
          label: "FOR PRODUCT TEAMS",
          title: "Flexible model choice",
        },
        {
          description: "Understand costs through usage, requests, and account pricing so routine operations and diagnosis stay clear.",
          index: "03",
          label: "FOR OPERATIONS",
          title: "A clearer operating view",
        },
      ],
      cta: {
        action: "Browse models",
        href: localizedPath("en", "/models"),
        label: "EXPLORE THE CATALOG",
        title: "Explore the models available now.",
      },
    },
    terms: {
      eyebrow: "Legal",
      titleLines: ["READ THE", "TERMS OF", "SERVICE."],
      lead: "Read the current terms covering Token Boat accounts, service use, and billing-related matters.",
      cards: [],
    },
    privacy: {
      eyebrow: "Legal",
      titleLines: ["UNDERSTAND THE", "PRIVACY", "POLICY."],
      lead: "Learn how Token Boat handles information related to accounts, service access, and user-submitted content.",
      cards: [],
    },
  },
};
const content = pages[props.locale][props.page];
const legalDocument = props.page === "terms" ? "terms" : "privacy";
const legalDraftHtml = marked.parse(legalDocumentDrafts[props.locale][legalDocument], {
  async: false,
}) as string;
---

<EditorialPageHero lead={content.lead} locale={props.locale} meta={content.eyebrow} titleLines={content.titleLines} />

{content.cards.length > 0 && (
  <section class="section content-section" id="page-content">
    <div class="site-shell content-grid">
      {content.cards.map((card) => (
        <article class="content-card">
          <div class="content-card__meta">
            <span>{card.index}</span>
            <p>{card.label}</p>
          </div>
          <h2>{card.title}</h2>
          <p>{card.description}</p>
          {card.href && card.action && (
            <a href={card.href}>{card.action}<span aria-hidden="true">↗</span></a>
          )}
        </article>
      ))}
    </div>
  </section>
)}

{props.page === "status" && (
  <section class="section public-data-section" id="status-details">
    <div class="site-shell"><StatusPanel client:load locale={props.locale} /></div>
  </section>
)}

{(props.page === "terms" || props.page === "privacy") && (
  <section class="section public-data-section" id="document">
    <div class="site-shell">
      <LegalDocument client:load document={legalDocument} fallbackHtml={legalDraftHtml} locale={props.locale} />
    </div>
  </section>
)}

{content.cta && (
  <section class="content-cta">
    <div class="site-shell content-cta__inner">
      <p>{content.cta.label}</p>
      <h2>{content.cta.title}</h2>
      <a class="button" href={content.cta.href}>{content.cta.action}<span aria-hidden="true">↗</span></a>
    </div>
  </section>
)}
