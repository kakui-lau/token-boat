---
import { localizedPath, type SiteLocale } from "@/content/site-copy";
import { legalDocuments } from "@/content/legal-documents";
import { LegalDocument } from "@/islands/legal/legal-document";
import { demoteLegalMarkdownHeadings } from "@/islands/legal/legal-content";
import { StatusPanel } from "@/islands/status/status-panel";
import EditorialPageHero from "@/components/editorial-page-hero.astro";
import { marked } from "marked";

type ContentPageKey = "about" | "docs" | "privacy" | "status" | "terms";

type Props = {
  locale: SiteLocale;
  page: ContentPageKey;
};

type ContentCard = {
  action?: string;
  description: string;
  href?: string;
  index: string;
  label: string;
  title: string;
};

type ContentPage = {
  cards: ContentCard[];
  cta?: { action: string; href: string; label: string; title: string };
  eyebrow: string;
  lead: string;
  titleLines: string[];
};

const props = Astro.props;
const pages: Record<SiteLocale, Record<ContentPageKey, ContentPage>> = {
