const c = copies[locale];
const sections = [["quickstart", c.quickstart], ["authentication", c.auth], ["examples", c.examples], ["streaming", c.streaming], ["errors", c.errors], ["rate-limits", c.limits], ["endpoints", c.endpoints]];
---

<EditorialPageHero lead={c.lead} locale={locale} meta={c.eyebrow} titleLines={c.titleLines} />
<section class="section docs-section">
  <div class="site-shell docs-layout">
    <aside class="docs-toc"><p>{c.toc}</p><nav aria-label={c.toc}>{sections.map(([id, label], i) => <a href={`#${id}`}><span>0{i + 1}</span>{label}</a>)}</nav></aside>
    <div class="docs-content">
      <section id="quickstart" class="docs-block"><p class="eyebrow">01 / START</p><h2>{c.quickstart}</h2><ol class="docs-steps">{c.keySteps.map((step) => <li>{step}</li>)}</ol><div class="docs-actions"><a class="button" href="/console/api-keys">{c.accountLink}<span aria-hidden="true">↗</span></a><a class="text-action" href={localizedPath(locale, "/models")}>{c.modelLink}<span aria-hidden="true">→</span></a></div></section>
      <section id="authentication" class="docs-block"><p class="eyebrow">02 / AUTH</p><h2>{c.auth}</h2><p>{c.authLead}</p><div class="docs-facts"><div><span>{c.base}</span><code>https://tokenboat.com/v1</code></div><div><span>{c.authHeader}</span><code>Authorization: Bearer $TOKEN_BOAT_API_KEY</code></div></div></section>
      <section id="examples" class="docs-block"><p class="eyebrow">03 / CALL</p><h2>{c.examples}</h2><div class="code-stack"><details data-animated-details open><summary>Curl</summary><div class="details-reveal"><pre><code>{quickstartCode.curl}</code></pre></div></details><details data-animated-details><summary>Python</summary><div class="details-reveal"><pre><code>{quickstartCode.python}</code></pre></div></details><details data-animated-details><summary>JavaScript</summary><div class="details-reveal"><pre><code>{quickstartCode.javascript}</code></pre></div></details></div></section>
      <section id="streaming" class="docs-block"><p class="eyebrow">04 / STREAM</p><h2>{c.streaming}</h2><p>{c.streamLead}</p><pre><code>{quickstartCode.streaming}</code></pre></section>
      <section id="errors" class="docs-block"><p class="eyebrow">05 / RECOVER</p><h2>{c.errors}</h2><p>{c.errorLead}</p><div class="docs-table-wrap"><table><thead><tr><th>Status</th><th>{locale === "zh" ? "含义" : locale === "zh-TW" ? "含義" : locale === "ja" ? "意味" : locale === "ko" ? "의미" : "Meaning"}</th><th>{locale === "zh" ? "建议动作" : locale === "zh-TW" ? "建議動作" : locale === "ja" ? "対応" : locale === "ko" ? "조치" : "Action"}</th></tr></thead><tbody>{c.errorRows.map((row) => <tr>{row.map((cell) => <td>{cell}</td>)}</tr>)}</tbody></table></div></section>
      <section id="rate-limits" class="docs-block"><p class="eyebrow">06 / LIMITS</p><h2>{c.limits}</h2><p>{c.limitsLead}</p><ul class="docs-list">{c.limitsList.map((item) => <li>{item}</li>)}</ul></section>
      <section id="endpoints" class="docs-block"><p class="eyebrow">07 / REFERENCE</p><h2>{c.endpoints}</h2><p>{c.endpointLead}</p><div class="docs-table-wrap"><table><thead><tr><th>{c.method}</th><th>{c.path}</th><th>{c.purpose}</th></tr></thead><tbody>{relayEndpoints.map((endpoint) => <tr><td><span class={`method-badge method-badge--${endpoint.method.toLowerCase()}`}>{endpoint.method}</span></td><td><code>{endpoint.path}</code></td><td>{endpoint.description[locale]}</td></tr>)}</tbody></table></div><p class="docs-source">{c.source}</p></section>
    </div>
  </div>
</section>
