    errorRows: [["400", "請求欄位或模型參數無效", "修正請求後再試"], ["401", "API Key 缺少、無效或已失效", "檢查 Authorization 標頭與 Key 狀態"], ["403", "帳戶或模型不可存取", "檢查帳戶權限與模型可用性"], ["429", "達到請求或 Token 限制", "遵循 Retry-After 並使用加入抖動的指數退避"], ["5xx", "閘道或上游暫時無法使用", "只對可安全重送的請求有限重試"]],
