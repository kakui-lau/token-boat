---
import { modelDisplayName } from "@/content/model-routes";
import type { SiteLocale } from "@/content/site-copy";
import { ModelDetailPageIsland } from "@/islands/models/model-detail-page";
import EditorialPageHero from "@/components/editorial-page-hero.astro";
type Props = { locale: SiteLocale; modelId: string };
const { locale, modelId } = Astro.props;
const displayName = modelDisplayName(modelId);
const provider = modelId.split("/")[0]?.toUpperCase() ?? "MODEL";
const copy = {
  zh: { lead: "查看公开能力、兼容端点、已核验限制、完整计费组件与近 24 小时匿名聚合性能。", facts: "模型标识" },
  en: { lead: "Review public capabilities, compatible endpoints, verified limits, complete price components, and anonymous 24-hour performance aggregates.", facts: "Model identity" },
  ja: { lead: "公開機能、互換エンドポイント、確認済みの制限、料金項目、過去24時間の匿名集計パフォーマンスを確認できます。", facts: "モデル識別子" },
  ko: { lead: "공개 기능, 호환 엔드포인트, 확인된 제한, 전체 과금 항목 및 최근 24시간 익명 집계 성능을 확인하세요.", facts: "모델 식별자" },
  "zh-TW": { lead: "查看公開能力、相容端點、已驗證限制、完整計費項目與近 24 小時匿名彙總效能。", facts: "模型識別碼" },
}[locale];
---
<EditorialPageHero facts={[["MODEL ID", modelId]]} factsLabel={copy.facts} lead={copy.lead} locale={locale} meta={`MODEL / ${provider}`} titleLines={[provider, displayName]} />
<section class="section model-detail-content"><div class="site-shell"><ModelDetailPageIsland client:load locale={locale} modelId={modelId} /></div></section>
