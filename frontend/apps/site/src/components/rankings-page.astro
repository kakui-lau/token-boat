---
import { type SiteLocale } from "@/content/site-copy";
import { RankingsBoardIsland } from "@/islands/rankings/rankings-board";
import EditorialPageHero from "@/components/editorial-page-hero.astro";

type Props = {
  locale: SiteLocale;
};

const props = Astro.props;
const content = {
  zh: {
    eyebrow: "平台用量排行榜",
    titleLines: ["看看谁", "正在被真正", "使用。"],
    lead: "基于 Token Boat 匿名聚合用量，观察模型热度、供应商份额与排名变化。这里衡量使用量，不代表模型质量或官方推荐。",
    facts: [
      ["01 / SIGNAL", "真实聚合用量"],
      ["02 / WINDOWS", "今日 · 周 · 月 · 年"],
      ["03 / PRIVACY", "不展示用户数据"],
    ],
  },
  en: {
    eyebrow: "Platform usage rankings",
    titleLines: ["SEE WHAT IS", "ACTUALLY BEING", "USED."],
    lead: "Follow model activity, provider share, and rank movement from anonymous aggregated Token Boat usage. This measures usage, not model quality or endorsement.",
    facts: [
      ["01 / SIGNAL", "Real aggregate usage"],
      ["02 / WINDOWS", "Today · week · month · year"],
      ["03 / PRIVACY", "No user-level data"],
    ],
  },
  ja: {
    eyebrow: "プラットフォーム利用ランキング",
    titleLines: ["実際に", "使われている", "モデルを見る。"],
    lead: "Token Boat の匿名集計データから、モデルの利用動向、プロバイダー比率、順位変動を確認できます。品質評価や推奨を示すものではありません。",
    facts: [
      ["01 / SIGNAL", "実利用の集計データ"],
      ["02 / WINDOWS", "今日 · 週 · 月 · 年"],
      ["03 / PRIVACY", "ユーザー単位のデータなし"],
    ],
  },
  ko: {
    eyebrow: "플랫폼 사용량 순위",
    titleLines: ["실제로", "사용되는 모델을", "확인하세요."],
    lead: "Token Boat의 익명 집계 사용량을 바탕으로 모델 활동, 공급자 점유율, 순위 변화를 확인합니다. 모델 품질 평가나 추천을 의미하지 않습니다.",
    facts: [
      ["01 / SIGNAL", "실제 집계 사용량"],
      ["02 / WINDOWS", "오늘 · 주 · 월 · 연"],
      ["03 / PRIVACY", "사용자 단위 데이터 없음"],
    ],
  },
  "zh-TW": {
    eyebrow: "平台用量排行榜",
    titleLines: ["看看誰", "正在被真正", "使用。"],
    lead: "根據 Token Boat 匿名彙總用量，觀察模型熱度、供應商占比與排名變化。這裡衡量使用量，不代表模型品質或官方推薦。",
    facts: [
      ["01 / SIGNAL", "真實彙總用量"],
      ["02 / WINDOWS", "今日 · 週 · 月 · 年"],
      ["03 / PRIVACY", "不顯示使用者資料"],
    ],
  },
}[props.locale];
const factsLabels: Record<SiteLocale, string> = {
  zh: "排行榜說明",
  en: "Ranking notes",
  ja: "ランキングについて",
  ko: "순위 안내",
  "zh-TW": "排行榜說明",
};
---

<EditorialPageHero facts={content.facts} factsLabel={factsLabels[props.locale]} lead={content.lead} locale={props.locale} meta={content.eyebrow} titleLines={content.titleLines} />

<section class="section rankings-section">
  <div class="site-shell">
    <RankingsBoardIsland client:load locale={props.locale} />
  </div>
</section>
