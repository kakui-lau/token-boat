---
import { localizedPath, type SiteLocale } from "@/content/site-copy";
import EditorialPageHero from "@/components/editorial-page-hero.astro";
type Props = { locale: SiteLocale };
const { locale } = Astro.props;
const c = {
  zh: {
    eyebrow: "SECURITY / TRUST", titleLines: ["说明数据", "如何经过", "网关。"], lead: "从 API Key、请求路由、供应商处理到日志与事件响应，说明服务当前的安全边界。", flowLabel: "请求数据流", flow: ["你的服务", "Token Boat 网关", "所选模型供应商", "响应返回"],
    cards: [["01", "身份与密钥", "API 请求使用 Bearer Key。密钥应只保存在服务端；账户可用的登录与二次验证方式取决于当前系统配置。"], ["02", "请求与供应商", "网关会把完成所选模型调用所需的请求内容发送给对应上游供应商。切换模型也可能改变处理数据的供应商。"], ["03", "日志与诊断", "控制台可提供请求、用量和错误诊断数据。保存期限依据数据类型、账户状态、法律及安全需要确定。"], ["04", "故障响应", "公开状态页只显示已配置的监控项。账户级异常应结合 Request ID 和请求日志定位。"], ["05", "隐私边界", "不要在非必要情况下提交个人信息、密钥或敏感业务数据。信息处理以隐私政策和服务条款为准。"], ["06", "访问控制", "按应用拆分并定期轮换 API Key；可用的 2FA、Passkey 和权限能力以当前账户配置为准。不要共享高权限账户。"], ["07", "最少必要", "只提交完成任务所需的数据。个人信息、密钥、受监管数据和敏感业务资料应先删除、脱敏或去标识化。"], ["08", "保留与删除", "日志和账务记录用途不同。数据不再需要时，会按照适用要求删除、匿名化或限制处理。"], ["09", "可验证声明", "仅展示有可发布证据支持的安全认证与保证。疑似安全问题可通过支持中心或支持邮箱报告。"]],
    privacy: "查看隐私政策", terms: "查看服务条款", status: "查看服务状态", support: "报告安全问题", cta: "继续核对服务边界。",
  },
  en: {
    eyebrow: "SECURITY / TRUST", titleLines: ["HOW DATA MOVES", "THROUGH THE", "GATEWAY."], lead: "From API keys and request routing to provider processing, logs, and incident response, this page describes the service's current security boundaries.", flowLabel: "Request data flow", flow: ["Your service", "Token Boat gateway", "Selected model provider", "Response returned"],
    cards: [["01", "Identity & keys", "API requests use a Bearer key. Keep keys server-side. Available sign-in and second-factor methods depend on current system configuration."], ["02", "Requests & providers", "The gateway sends the request content required for the selected model call to the corresponding upstream provider. Changing models may also change the data processor."], ["03", "Logs & diagnosis", "The console can expose request, usage, and error diagnostics. Retention depends on data type, account status, legal duties, and security needs."], ["04", "Incident response", "The public status page shows only configured monitors. Diagnose account-level failures with a Request ID and request logs."], ["05", "Privacy boundary", "Do not submit personal data, credentials, or sensitive business content unless required. The privacy policy and terms govern information handling."], ["06", "Access control", "Separate and rotate API keys by application. Available 2FA, passkey, and permission controls depend on current account configuration. Do not share privileged accounts."], ["07", "Data minimization", "Submit only what a task requires. Remove, redact, or de-identify personal data, credentials, regulated data, and sensitive business information before use."], ["08", "Retention & deletion", "Logs and billing records serve different purposes. Data that is no longer needed is deleted, anonymized, or restricted as applicable."], ["09", "Verifiable assurance", "Security certifications and assurances are displayed only when supported by publishable evidence. Report suspected issues through support or the published support email."]],
    privacy: "Read privacy policy", terms: "Read terms", status: "View service status", support: "Report a security issue", cta: "Continue with the service boundaries.",
  },
  ja: {
    eyebrow: "SECURITY / TRUST", titleLines: ["データが", "ゲートウェイを", "通る仕組み。"], lead: "API キー、リクエスト経路、プロバイダー処理、ログ、インシデント対応における現在の安全境界を説明します。", flowLabel: "リクエストデータの流れ", flow: ["利用者のサービス", "Token Boat ゲートウェイ", "選択したモデルプロバイダー", "レスポンス返却"],
    cards: [["01", "認証とキー", "API リクエストには Bearer Key を使います。キーはサーバー側だけに保存し、利用可能なログインと二要素認証は現在の設定で確認してください。"], ["02", "リクエストとプロバイダー", "選択したモデルの処理に必要な内容を対応する上流プロバイダーへ送信します。モデル変更により処理者も変わる場合があります。"], ["03", "ログと診断", "コンソールでリクエスト、使用量、エラー診断を確認できます。保存期間はデータ種別、アカウント状態、法的義務、安全上の必要性に応じます。"], ["04", "インシデント対応", "公開状態ページには設定済みの監視項目だけを表示します。アカウント固有の障害は Request ID とリクエストログで調査してください。"], ["05", "プライバシー境界", "必要がない個人情報、認証情報、機密業務データを送信しないでください。情報の取扱いはプライバシーポリシーと利用規約に従います。"], ["06", "アクセス制御", "アプリごとに API キーを分け、定期的にローテーションしてください。利用可能な 2FA、パスキー、権限はアカウント設定によります。"], ["07", "データ最小化", "タスクに必要なデータだけを送信し、個人情報、認証情報、規制対象データ、機密情報は削除、マスキング、匿名化してください。"], ["08", "保存と削除", "ログと課金記録には異なる目的があります。不要になったデータは適用される要件に従い削除、匿名化、または処理を制限します。"], ["09", "検証可能な説明", "公開可能な証拠で確認できる認証と保証だけを表示します。疑わしい安全上の問題はサポートへ報告してください。"]],
    privacy: "プライバシーポリシー", terms: "利用規約", status: "サービス状況", support: "セキュリティ問題を報告", cta: "サービスの境界を確認。",
  },
  ko: {
    eyebrow: "SECURITY / TRUST", titleLines: ["데이터가", "게이트웨이를", "통과하는 방식."], lead: "API 키, 요청 라우팅, 공급자 처리, 로그 및 사고 대응에 걸친 현재 보안 경계를 설명합니다.", flowLabel: "요청 데이터 흐름", flow: ["사용자 서비스", "Token Boat 게이트웨이", "선택한 모델 공급자", "응답 반환"],
    cards: [["01", "인증 및 키", "API 요청에는 Bearer Key를 사용합니다. 키는 서버 측에만 저장하고 로그인 및 2차 인증 방식은 현재 계정 설정을 확인하세요."], ["02", "요청 및 공급자", "선택한 모델 호출에 필요한 내용을 해당 상위 공급자에게 전송합니다. 모델을 바꾸면 데이터 처리자도 달라질 수 있습니다."], ["03", "로그 및 진단", "콘솔에서 요청, 사용량 및 오류 진단을 확인할 수 있습니다. 보관 기간은 데이터 유형, 계정 상태, 법적 의무와 보안 필요에 따라 결정됩니다."], ["04", "사고 대응", "공개 상태 페이지는 설정된 모니터만 표시합니다. 계정별 장애는 Request ID와 요청 로그로 진단하세요."], ["05", "개인정보 경계", "필요하지 않은 개인정보, 자격 증명 또는 민감한 업무 데이터를 제출하지 마세요. 정보 처리는 개인정보 처리방침과 약관을 따릅니다."], ["06", "접근 제어", "애플리케이션별로 API 키를 분리하고 정기적으로 교체하세요. 이용 가능한 2FA, 패스키 및 권한은 현재 계정 설정에 따라 다릅니다."], ["07", "데이터 최소화", "작업에 필요한 데이터만 제출하고 개인정보, 자격 증명, 규제 대상 데이터 및 민감 정보는 삭제, 마스킹 또는 비식별화하세요."], ["08", "보관 및 삭제", "로그와 과금 기록은 목적이 다릅니다. 필요하지 않은 데이터는 적용 요건에 따라 삭제, 익명화 또는 처리를 제한합니다."], ["09", "검증 가능한 보증", "게시 가능한 증거가 있는 보안 인증과 보증만 표시합니다. 의심되는 보안 문제는 지원 센터로 신고하세요."]],
    privacy: "개인정보 처리방침", terms: "서비스 약관", status: "서비스 상태", support: "보안 문제 신고", cta: "서비스 경계를 계속 확인하세요.",
  },
  "zh-TW": {
    eyebrow: "SECURITY / TRUST", titleLines: ["說明資料", "如何經過", "閘道。"], lead: "從 API Key、請求路由、供應商處理到記錄與事件回應，說明服務目前的安全邊界。", flowLabel: "請求資料流", flow: ["你的服務", "Token Boat 閘道", "所選模型供應商", "回傳回應"],
    cards: [["01", "身分與金鑰", "API 請求使用 Bearer Key。金鑰只應存放於伺服器端；可用登入與第二因素驗證方式以目前帳戶設定為準。"], ["02", "請求與供應商", "閘道會把完成所選模型呼叫所需的內容傳送給對應上游供應商。更換模型也可能改變資料處理方。"], ["03", "記錄與診斷", "控制台可提供請求、用量與錯誤診斷。保存期限依資料類型、帳戶狀態、法律義務及安全需要決定。"], ["04", "故障回應", "公開狀態頁只顯示已設定的監控項目。帳戶層級異常應搭配 Request ID 與請求記錄排查。"], ["05", "隱私邊界", "非必要時不要提交個人資訊、憑證或敏感商業資料。資訊處理以隱私權政策與服務條款為準。"], ["06", "存取控制", "依應用程式拆分並定期輪替 API Key；可用的 2FA、Passkey 與權限能力以目前帳戶設定為準。"], ["07", "資料最小化", "只提交完成任務所需的資料。個人資訊、憑證、受監管資料與敏感資訊應先刪除、遮蔽或去識別化。"], ["08", "保存與刪除", "記錄與帳務資料有不同用途。資料不再需要時，會依適用要求刪除、匿名化或限制處理。"], ["09", "可驗證聲明", "只顯示有可發布證據支持的安全認證與保證。疑似安全問題可透過支援中心或支援信箱回報。"]],
    privacy: "查看隱私權政策", terms: "查看服務條款", status: "查看服務狀態", support: "回報安全問題", cta: "繼續確認服務邊界。",
  },
}[locale];
---
<EditorialPageHero lead={c.lead} locale={locale} meta={c.eyebrow} titleLines={c.titleLines} />
<section class="trust-flow-section"><div class="site-shell"><ol class="data-flow" aria-label={c.flowLabel}>{c.flow.map((step, i) => <li><span>0{i + 1}</span><strong>{step}</strong></li>)}</ol></div></section>
<section class="section content-section"><div class="site-shell content-grid trust-grid">{c.cards.map((card) => <article class="content-card"><div class="content-card__meta"><span>{card[0]}</span><p>TRUST NOTE</p></div><h2>{card[1]}</h2><p>{card[2]}</p></article>)}</div></section>
<section class="content-cta"><div class="site-shell content-cta__inner"><p>POLICY & STATUS</p><h2>{c.cta}</h2><div class="inline-links"><a href={localizedPath(locale, "/legal/privacy")}>{c.privacy} →</a><a href={localizedPath(locale, "/legal/terms")}>{c.terms} →</a><a href={localizedPath(locale, "/status")}>{c.status} →</a><a href="mailto:support@quantumnous.com">{c.support} →</a></div></div></section>
