---
import SiteLayout from "@/layouts/site-layout.astro";
---
<SiteLayout
  canonicalPath="/404"
  description="请求的 Token Boat 页面不存在或已经移动。"
  locale="zh"
  noindex
  title="页面未找到｜Token Boat"
>
  <section class="not-found">
    <div class="site-shell not-found__grid">
      <div class="not-found__content">
        <p class="eyebrow">错误 / 404</p>
        <h1>这一页<br />没有上船。</h1>
        <p class="not-found__lead">页面不存在，可能已经被移动或删除。你可以返回首页，或前往模型目录继续浏览。</p>
        <div class="not-found__actions">
          <a class="button" href="/">返回首页<span aria-hidden="true">↗</span></a>
          <a class="not-found__secondary" href="/models">浏览模型<span aria-hidden="true">→</span></a>
        </div>
      </div>
      <div class="not-found__visual" aria-hidden="true">
        <span>404</span>
        <div class="not-found__boat"><i></i></div>
        <p>PAGE NOT FOUND</p>
      </div>
    </div>
  </section>
</SiteLayout>
